L.Add('def resolve(template, inputs, results, self_json=""):');
L.Add('    """Substitute every {{...}} in an args JSON text, as the engine does."""');
L.Add('    resolved = template');
L.Add('    for inner in scan_placeholders(template):');
L.Add('        if "." not in inner:');
L.Add('            raise StepError(''bad template "{{%s}}"'' % inner)');
L.Add('        kind, rest = inner.split(".", 1)');
L.Add('        if kind == "inputs":');
L.Add('            if rest not in inputs:');
L.Add('                raise StepError(''missing input "%s" for {{%s}}'' % (rest, inner))');
L.Add('            v = inputs[rest]');
L.Add('            val = v if isinstance(v, str) else ""');
L.Add('        elif kind == "self":');
L.Add('            val = eval_selector(self_json, rest)');
L.Add('            if val is None:');
L.Add('                raise StepError("{{%s}}: selector \"%s\" did not resolve in this node''s result" % (inner, rest))');
L.Add('        elif kind == "nodes":');
L.Add('            node_id, _, sel = rest.partition(".")');
L.Add('            r = find_result(results, node_id)');
L.Add('            if r is None:');
L.Add('                raise StepError(''{{%s}} references node "%s" that has not run'' % (inner, node_id))');
L.Add('            if not sel:');
L.Add('                val = r["text"]');
L.Add('            else:');
L.Add('                val = eval_selector(r["json"], sel)');
L.Add('                if val is None:');
L.Add('                    raise StepError(''{{%s}}: selector "%s" did not resolve in node "%s" output'' % (inner, sel, node_id))');
L.Add('        else:');
L.Add('            raise StepError(''unknown template kind "%s" in {{%s}}'' % (kind, inner))');
L.Add('        resolved = resolved.replace("{{" + inner + "}}", json_escape(val))');
L.Add('    return resolved');
L.Add('');

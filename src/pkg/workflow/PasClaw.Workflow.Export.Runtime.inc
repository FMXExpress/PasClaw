L.Add('def eval_selector(text, selector):');
L.Add('    """A dotted/[i] path into a JSON text; None when it does not resolve."""');
L.Add('    steps = split_selector(selector)');
L.Add('    if not steps:');
L.Add('        return None');
L.Add('    cur = text');
L.Add('    if steps[0] == "structuredContent":');
L.Add('        o = _parse(cur, dict)');
L.Add('        if o is not None and "structuredContent" not in o:');
L.Add('            steps = steps[1:]');
L.Add('        if not steps:');
L.Add('            return None');
L.Add('    for st in steps:');
L.Add('        if st.startswith("#"):');
L.Add('            try:');
L.Add('                idx = int(st[1:])');
L.Add('            except ValueError:');
L.Add('                return None');
L.Add('            arr = _parse(cur, list)');
L.Add('            if idx < 0 or arr is None or idx >= len(arr):');
L.Add('                return None');
L.Add('            item = arr[idx]');
L.Add('            if isinstance(item, (dict, list)):');
L.Add('                cur = fp_json(item)');
L.Add('            else:');
L.Add('                cur = item_text(item)');
L.Add('                if cur is None:');
L.Add('                    return None');
L.Add('        else:');
L.Add('            obj = _parse(cur, dict)');
L.Add('            if obj is None or st not in obj:');
L.Add('                return None');
L.Add('            item = obj[st]');
L.Add('            if isinstance(item, (dict, list)):');
L.Add('                cur = fp_json(item)');
L.Add('            elif isinstance(item, str):');
L.Add('                cur = item');
L.Add('            else:');
L.Add('                return None');
L.Add('    return cur');

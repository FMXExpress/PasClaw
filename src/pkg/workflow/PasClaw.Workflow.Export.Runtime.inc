L.Add('def split_selector(sel):');
L.Add('    out, tok, i, n = [], "", 0, len(sel)');
L.Add('    while i < n:');
L.Add('        c = sel[i]');
L.Add('        if c == ".":');
L.Add('            if tok:');
L.Add('                out.append(tok)');
L.Add('                tok = ""');
L.Add('            i += 1');
L.Add('        elif c == "[":');
L.Add('            if tok:');
L.Add('                out.append(tok)');
L.Add('                tok = ""');
L.Add('            i += 1');
L.Add('            num = ""');
L.Add('            while i < n and sel[i] != "]":');
L.Add('                num += sel[i]');
L.Add('                i += 1');
L.Add('            if i < n and sel[i] == "]":');
L.Add('                i += 1');
L.Add('            out.append("#" + pas_trim(num))');
L.Add('        else:');
L.Add('            tok += c');
L.Add('            i += 1');
L.Add('    if tok:');
L.Add('        out.append(tok)');
L.Add('    return out');

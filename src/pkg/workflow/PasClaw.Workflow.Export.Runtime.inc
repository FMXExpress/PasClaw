L.Add('def plan_node(node):');
L.Add('    tool = node["tool"]');
L.Add('    aw = node.get("await")');
L.Add('    t = pas_trim(tool).lower()');
L.Add('    eff = "replicate__create_predictions" if t == "replicate" else tool');
L.Add('    if t in ("replicate", "replicate__create_predictions") and not aw:');
L.Add('        aw = {"tool": "replicate__get_predictions", "args": ''{"prediction_id":"{{self.id}}"}'',');
L.Add('              "status_selector": "status", "output_selector": "output[0]",');
L.Add('              "interval_ms": 2000, "timeout_ms": 300000,');
L.Add('              "success": ["succeeded"], "failure": ["failed", "canceled", "aborted"]}');
L.Add('    return eff, aw');

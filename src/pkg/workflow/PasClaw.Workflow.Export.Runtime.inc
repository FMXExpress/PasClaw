L.Add('# --------------------------------------------------------------- replicate');
L.Add('# A `replicate` step runs over Replicate''s HTTP API: the create here, then the');
L.Add('# step''s await plan -- PasClaw''s own (plan_node) or the one written on the step');
L.Add('# -- polls, its replicate__get_predictions answered by the HTTP API as well.');
L.Add('def _replicate_api():');
L.Add('    token = os.environ.get("REPLICATE_API_TOKEN", "")');
L.Add('    if not token:');
L.Add('        raise StepError("replicate step: set REPLICATE_API_TOKEN")');
L.Add('    base = os.environ.get("REPLICATE_API_BASE", "https://api.replicate.com").rstrip("/")');
L.Add('    return base, {"Authorization": "Bearer " + token}');
L.Add('');
L.Add('');
L.Add('def replicate_create(args_json):');
L.Add('    """A `replicate` step''s create: the prediction, as JSON text."""');
L.Add('    base, headers = _replicate_api()');
L.Add('    a = _parse(args_json, dict) or {}');
L.Add('    inp = a.get("input") if isinstance(a.get("input"), dict) else {}');
L.Add('    model, version = _str_arg(a, "model"), _str_arg(a, "version")');
L.Add('    if not version and ":" in model:');
L.Add('        model, version = model.split(":", 1)');
L.Add('    if version:');
L.Add('        url, body = base + "/v1/predictions", {"version": version, "input": inp}');
L.Add('    elif model:');
L.Add('        url, body = base + "/v1/models/" + model + "/predictions", {"input": inp}');
L.Add('    else:');
L.Add('        raise StepError(''replicate step: "model" or "version" is required'')');
L.Add('    status, text = http_json("POST", url, body, headers)');
L.Add('    if status >= 400:');
L.Add('        raise StepError("replicate: create returned %d: %s" % (status, text[:300]))');
L.Add('    return text');
L.Add('');
L.Add('');
L.Add('def replicate_get(args_json):');
L.Add('    """replicate__get_predictions over the HTTP API: the prediction, as JSON text."""');
L.Add('    base, headers = _replicate_api()');
L.Add('    pid = _str_arg(_parse(args_json, dict) or {}, "prediction_id")');
L.Add('    if not pid:');
L.Add('        raise StepError(''replicate__get_predictions: "prediction_id" is required'')');
L.Add('    status, text = http_json("GET", base + "/v1/predictions/" + pid, None, headers)');
L.Add('    if status >= 400:');
L.Add('        raise StepError("replicate: poll returned %d: %s" % (status, text[:300]))');
L.Add('    return text, text');
L.Add('');

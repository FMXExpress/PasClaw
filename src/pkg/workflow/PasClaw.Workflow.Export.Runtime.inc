L.Add('def resolve_one(template, inputs, results):');
L.Add('    """A single template (an output''s value, the loop''s until) to its value."""');
L.Add('    wrapped = ''{"v":"'' + json_escape(template) + ''"}''');
L.Add('    resolved = resolve(wrapped, inputs, results)');
L.Add('    o = _parse(resolved, dict)');
L.Add('    v = o.get("v") if o is not None else None');
L.Add('    return v if isinstance(v, str) else ""');

L.Add('def pas_trim(s):');
L.Add('    """Pascal''s Trim: drop characters <= '' '' at both ends."""');
L.Add('    i, j = 0, len(s)');
L.Add('    while i < j and s[i] <= " ":');
L.Add('        i += 1');
L.Add('    while j > i and s[j - 1] <= " ":');
L.Add('        j -= 1');
L.Add('    return s[i:j]');

L.Add('def json_escape(s):');
L.Add('    """PasClaw.JSON.JsonEscape: what a substituted value becomes."""');
L.Add('    out = []');
L.Add('    for c in s:');
L.Add('        if c == ''"'':');
L.Add('            out.append(''\\"'')');
L.Add('        elif c == "\\":');
L.Add('            out.append("\\\\")');
L.Add('        elif c == "\b":');
L.Add('            out.append("\\b")');
L.Add('        elif c == "\t":');
L.Add('            out.append("\\t")');
L.Add('        elif c == "\n":');
L.Add('            out.append("\\n")');
L.Add('        elif c == "\f":');
L.Add('            out.append("\\f")');
L.Add('        elif c == "\r":');
L.Add('            out.append("\\r")');
L.Add('        elif ord(c) < 32:');
L.Add('            out.append("\\u%04X" % ord(c))');
L.Add('        else:');
L.Add('            out.append(c)');
L.Add('    return "".join(out)');

L.Add('# --------------------------------------------------------------- HTTP');
L.Add('def http_json(method, url, body, headers, timeout=300):');
L.Add('    data = None if body is None else json.dumps(body).encode("utf-8")');
L.Add('    req = urllib.request.Request(url, data=data, method=method)');
L.Add('    req.add_header("Accept", "application/json")');
L.Add('    if data is not None:');
L.Add('        req.add_header("Content-Type", "application/json")');
L.Add('    for k, v in headers.items():');
L.Add('        req.add_header(k, v)');
L.Add('    try:');
L.Add('        with urllib.request.urlopen(req, timeout=timeout) as r:');
L.Add('            return r.status, r.read().decode("utf-8", "replace")');
L.Add('    except urllib.error.HTTPError as e:');
L.Add('        return e.code, e.read().decode("utf-8", "replace")');
L.Add('    except (urllib.error.URLError, OSError) as e:');
L.Add('        raise StepError("%s %s: %s" % (method, url, e))');
L.Add('');

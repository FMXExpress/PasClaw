L.Add('def topo_order(spec):');
L.Add('    nodes = spec["nodes"]');
L.Add('    ids = [n["id"] for n in nodes]');
L.Add('    n = len(nodes)');
L.Add('    dep = [[False] * n for _ in range(n)]');
L.Add('    for e in spec["edges"]:');
L.Add('        if e["from"] not in ids:');
L.Add('            raise StepError(''edge from unknown node "%s"'' % e["from"])');
L.Add('        if e["to"] not in ids:');
L.Add('            raise StepError(''edge to unknown node "%s"'' % e["to"])');
L.Add('        dep[ids.index(e["to"])][ids.index(e["from"])] = True');
L.Add('    for i, node in enumerate(nodes):');
L.Add('        for inner in scan_placeholders(node["args"]):');
L.Add('            if inner.startswith("nodes."):');
L.Add('                ref = inner[6:].split(".", 1)[0]');
L.Add('                if ref not in ids:');
L.Add('                    raise StepError(''node "%s" references unknown node "%s"'' % (node["id"], ref))');
L.Add('                if ids.index(ref) == i:');
L.Add('                    raise StepError(''node "%s" references itself'' % node["id"])');
L.Add('                dep[i][ids.index(ref)] = True');
L.Add('    indeg = [sum(1 for j in range(n) if dep[i][j]) for i in range(n)]');
L.Add('    done, order = [False] * n, []');
L.Add('    while len(order) < n:');
L.Add('        ready = [i for i in range(n) if not done[i] and indeg[i] == 0]');
L.Add('        if not ready:');
L.Add('            raise StepError("workflow has a cycle")');
L.Add('        j = ready[0]');
L.Add('        done[j] = True');
L.Add('        order.append(ids[j])');
L.Add('        for i in range(n):');
L.Add('            if not done[i] and dep[i][j]:');
L.Add('                indeg[i] -= 1');
L.Add('    return order');
L.Add('');

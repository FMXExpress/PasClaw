L.Add('# --------------------------------------------------------------- llm');
L.Add('def llm_call(args_json):');
L.Add('    a = _parse(args_json, dict)');
L.Add('    if a is None:');
L.Add('        raise StepError("llm node: bad args JSON")');
L.Add('    prov = pas_trim(_str_arg(a, "provider")) or DEFAULT_PROVIDER');
L.Add('    model = pas_trim(_str_arg(a, "model"))');
L.Add('    prompt, system = _str_arg(a, "prompt"), _str_arg(a, "system")');
L.Add('    if prompt == "":');
L.Add('        raise StepError(''llm node: "prompt" is required'')');
L.Add('    p = PROVIDERS.get(prov, {})');
L.Add('    base = (os.environ.get("LLM_BASE_URL") or p.get("base_url") or "https://api.openai.com").rstrip("/")');
L.Add('    url = base + ("/chat/completions" if base.endswith("/v1") else "/v1/chat/completions")');
L.Add('    model = os.environ.get("LLM_MODEL") or model or p.get("model") or DEFAULT_MODEL');
L.Add('    key = os.environ.get(p.get("key_env", "") or "LLM_API_KEY") or os.environ.get("LLM_API_KEY") \');
L.Add('        or os.environ.get("OPENAI_API_KEY", "")');
L.Add('    msgs = ([{"role": "system", "content": system}] if system else []) + [{"role": "user", "content": prompt}]');
L.Add('    headers = {"Authorization": "Bearer " + key} if key else {}');
L.Add('    status, body = http_json("POST", url, {"model": model, "messages": msgs}, headers)');
L.Add('    if status >= 400:');
L.Add('        raise StepError(''llm node: provider "%s" returned status %d'' % (prov, status))');
L.Add('    j = _parse(body, dict) or {}');
L.Add('    msg = ((j.get("choices") or [{}])[0] or {}).get("message") or {}');
L.Add('    content = msg.get("content") or ""');
L.Add('    if isinstance(content, list):');
L.Add('        content = "".join(c.get("text", "") for c in content if isinstance(c, dict))');
L.Add('    return content, text_wrap(content)');
L.Add('');

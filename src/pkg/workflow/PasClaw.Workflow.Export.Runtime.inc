L.Add('# --------------------------------------------------------------- MCP');
L.Add('class _MCPPool:');
L.Add('    """One session per server, kept open for the run (stdio or HTTP)."""');
L.Add('');
L.Add('    def __init__(self):');
L.Add('        import asyncio');
L.Add('        import threading');
L.Add('        self.asyncio = asyncio');
L.Add('        self.loop = asyncio.new_event_loop()');
L.Add('        threading.Thread(target=self.loop.run_forever, daemon=True).start()');
L.Add('        self.queues, self.tasks = {}, []');
L.Add('');
L.Add('    def call(self, server, tool, args):');
L.Add('        return self.asyncio.run_coroutine_threadsafe(self._call(server, tool, args), self.loop).result()');
L.Add('');
L.Add('    async def _call(self, server, tool, args):');
L.Add('        if server not in self.queues:');
L.Add('            ready = self.loop.create_future()');
L.Add('            q = self.asyncio.Queue()');
L.Add('            self.queues[server] = q');
L.Add('            self.tasks.append(self.loop.create_task(self._serve(server, q, ready)))');
L.Add('            await ready');
L.Add('        fut = self.loop.create_future()');
L.Add('        await self.queues[server].put((tool, args, fut))');
L.Add('        return await fut');
L.Add('');
L.Add('    async def _serve(self, server, q, ready):');
L.Add('        from contextlib import asynccontextmanager');
L.Add('        from mcp import ClientSession');
L.Add('        cfg = MCP_SERVERS[server]');
L.Add('');
L.Add('        @asynccontextmanager');
L.Add('        async def transport():');
L.Add('            if cfg.get("url"):');
L.Add('                headers = {}');
L.Add('                if os.environ.get(cfg.get("auth_env", "")):');
L.Add('                    headers["Authorization"] = os.environ[cfg["auth_env"]]');
L.Add('                try:');
L.Add('                    from mcp.client.streamable_http import streamable_http_client, create_mcp_http_client');
L.Add('                    async with create_mcp_http_client(headers=headers) as client:');
L.Add('                        async with streamable_http_client(cfg["url"], http_client=client) as s:');
L.Add('                            yield s[0], s[1]');
L.Add('                except ImportError:');
L.Add('                    from mcp.client.streamable_http import streamablehttp_client');
L.Add('                    async with streamablehttp_client(cfg["url"], headers=headers) as s:');
L.Add('                        yield s[0], s[1]');
L.Add('            else:');
L.Add('                from mcp import StdioServerParameters');
L.Add('                from mcp.client.stdio import stdio_client');
L.Add('                params = StdioServerParameters(command=cfg["command"], args=list(cfg.get("args", [])),');
L.Add('                                               env=dict(os.environ))');
L.Add('                async with stdio_client(params) as s:');
L.Add('                    yield s[0], s[1]');
L.Add('');
L.Add('        try:');
L.Add('            async with transport() as (read, write):');
L.Add('                async with ClientSession(read, write) as session:');
L.Add('                    await session.initialize()');
L.Add('                    ready.set_result(None)');
L.Add('                    while True:');
L.Add('                        item = await q.get()');
L.Add('                        if item is None:');
L.Add('                            break');
L.Add('                        tool, args, fut = item');
L.Add('                        try:');
L.Add('                            fut.set_result(await session.call_tool(tool, args))');
L.Add('                        except Exception as e:  # noqa: BLE001 -- surfaced at the step');
L.Add('                            fut.set_exception(e)');
L.Add('        except Exception as e:  # noqa: BLE001');
L.Add('            if not ready.done():');
L.Add('                ready.set_exception(e)');
L.Add('');
L.Add('    def close(self):');
L.Add('        async def stop():');
L.Add('            for q in self.queues.values():');
L.Add('                await q.put(None)');
L.Add('            for t in self.tasks:');
L.Add('                try:');
L.Add('                    await self.asyncio.wait_for(t, 10)');
L.Add('                except Exception:  # noqa: BLE001');
L.Add('                    pass');
L.Add('        try:');
L.Add('            self.asyncio.run_coroutine_threadsafe(stop(), self.loop).result(15)');
L.Add('        except Exception:  # noqa: BLE001');
L.Add('            pass');
L.Add('');
L.Add('');
L.Add('_POOL = []');
L.Add('');
L.Add('');
L.Add('def mcp_call(tool, args_json):');
L.Add('    server = next((s for s in MCP_SERVERS if tool.startswith(s + "__") and len(tool) > len(s) + 2), None)');
L.Add('    if server is None:');
L.Add('        raise StepError(''no MCP tool named "%s" (no server prefix or bare-name match)'' % tool)');
L.Add('    try:');
L.Add('        import mcp  # noqa: F401 -- only MCP steps need the package');
L.Add('    except ImportError:');
L.Add('        raise StepError(''MCP step "%s" needs the mcp package: pip install mcp'' % tool)');
L.Add('    if not _POOL:');
L.Add('        _POOL.append(_MCPPool())');
L.Add('    args = _parse(args_json, dict)');
L.Add('    try:');
L.Add('        r = _POOL[0].call(server, tool[len(server) + 2:], args if args is not None else {})');
L.Add('    except Exception as e:  # noqa: BLE001');
L.Add('        raise StepError("mcp[%s] %s: %s" % (server, type(e).__name__, e))');
L.Add('    raw = r.model_dump(mode="json", by_alias=True, exclude_none=True) if hasattr(r, "model_dump") else dict(r)');
L.Add('    text = "\n".join(c.get("text", "") for c in raw.get("content", []) if c.get("type") == "text")');
L.Add('    if text == "" and raw.get("isError"):');
L.Add('        raise StepError("tool reported error (no text content)")');
L.Add('    return text, json.dumps(raw)');
L.Add('');
L.Add('');
L.Add('# --------------------------------------------------------------- built-in tools');
L.Add('def builtin_call(tool, args_json):');
L.Add('    a = _parse(args_json, dict) or {}');
L.Add('    if tool == "read_file":');
L.Add('        with open(_str_arg(a, "path"), encoding="utf-8", errors="replace") as f:');
L.Add('            return f.read()');
L.Add('    if tool == "write_file":');
L.Add('        path, content = _str_arg(a, "path"), _str_arg(a, "content")');
L.Add('        if os.path.dirname(path):');
L.Add('            os.makedirs(os.path.dirname(path), exist_ok=True)');
L.Add('        with open(path, "w", encoding="utf-8") as f:');
L.Add('            f.write(content)');
L.Add('        return "wrote %d bytes to %s" % (len(content.encode("utf-8")), path)');
L.Add('    if tool == "shell_exec":');
L.Add('        # PasClaw''s shell_exec: "cwd" resolves against the directory relative paths');
L.Add('        # do (here the current one), and one that does not exist is reported as');
L.Add('        # exit code 1 -- never a silent run in another directory.');
L.Add('        cwd = pas_trim(_str_arg(a, "cwd"))');
L.Add('        if cwd:');
L.Add('            cwd = os.path.abspath(cwd)');
L.Add('            if not os.path.isdir(cwd):');
L.Add('                return "shell_exec: cwd does not exist: %s\n[exit code 1]" % cwd');
L.Add('        r = subprocess.run(_str_arg(a, "command"), shell=True, capture_output=True, text=True, cwd=cwd or None)');
L.Add('        out = r.stdout + r.stderr');
L.Add('        if r.returncode != 0:');
L.Add('            out += "\n[exit code %d]" % r.returncode');
L.Add('        return out');
L.Add('    raise StepError(''tool "%s" is not supported in the exported script'' % tool)');
L.Add('');
L.Add('');
L.Add('def call_tool(tool, args_json):');
L.Add('    if tool in ("llm", "provider"):');
L.Add('        return llm_call(args_json)');
L.Add('    if "__" in tool:');
L.Add('        return mcp_call(tool, args_json)');
L.Add('    try:');
L.Add('        text = builtin_call(tool, args_json)');
L.Add('    except OSError as e:');
L.Add('        raise StepError("%s: %s" % (tool, e))');
L.Add('    return text, text_wrap(text)');
L.Add('');
L.Add('');
L.Add('# --------------------------------------------------------------- the run');
L.Add('def poll_until_done(aw, create_json, inputs, results, replicate=False):');
L.Add('    if not pas_trim(aw.get("tool", "")):');
L.Add('        raise StepError("await: no poll tool")');
L.Add('    elapsed = polls = 0');
L.Add('    interval, timeout = int(aw.get("interval_ms", 2000)), int(aw.get("timeout_ms", 300000))');
L.Add('    while True:');
L.Add('        args = resolve(aw.get("args", "{}"), inputs, results, create_json)');
L.Add('        try:');
L.Add('            if replicate and aw["tool"] == "replicate__get_predictions":');
L.Add('                ptext, pjson = replicate_get(args)');
L.Add('            else:');
L.Add('                ptext, pjson = call_tool(aw["tool"], args)');
L.Add('        except StepError as e:');
L.Add('            raise StepError("await: poll call failed: %s" % e)');
L.Add('        pjson = unwrap_result(pjson, ptext)');
L.Add('        status = eval_selector(pjson, aw.get("status_selector", "status"))');
L.Add('        if status is None:');
L.Add('            raise StepError(''await: status selector "%s" did not resolve in poll result'' % aw.get("status_selector"))');
L.Add('        if status in aw.get("success", ["succeeded"]):');
L.Add('            return ptext, pjson');
L.Add('        if status in aw.get("failure", ["failed", "canceled"]):');
L.Add('            raise StepError(''await: terminal failure status "%s"'' % status)');
L.Add('        polls += 1');
L.Add('        if interval > 0:');
L.Add('            elapsed += interval');
L.Add('        if timeout > 0 and elapsed >= timeout:');
L.Add('            raise StepError(''await: timed out after %d ms (last status "%s")'' % (elapsed, status))');
L.Add('        if polls >= 100000:');
L.Add('            raise StepError("await: exceeded max polls")');
L.Add('        if interval > 0:');
L.Add('            time.sleep(interval / 1000.0)');
L.Add('');
L.Add('');
L.Add('def run_workflow(spec, inputs):');
L.Add('    results = []');
L.Add('    try:');
L.Add('        order = topo_order(spec)');
L.Add('    except StepError as e:');
L.Add('        return False, results, str(e)');
L.Add('    nodes = {n["id"]: n for n in spec["nodes"]}');
L.Add('    for nid in order:');
L.Add('        node = nodes[nid]');
L.Add('        try:');
L.Add('            args = resolve(node["args"], inputs, results)');
L.Add('        except StepError as e:');
L.Add('            return False, results, ''node "%s": %s'' % (nid, e)');
L.Add('        eff, aw = plan_node(node)');
L.Add('        sugar = pas_trim(node["tool"]).lower() == "replicate"');
L.Add('        r = {"node": nid, "tool": node["tool"], "ok": True, "text": "", "json": "", "error": ""}');
L.Add('        try:');
L.Add('            if sugar:');
L.Add('                text = js = replicate_create(args)');
L.Add('            else:');
L.Add('                text, js = call_tool(eff, args)');
L.Add('            r["text"], r["json"] = text, unwrap_result(js, text)');
L.Add('            if aw:');
L.Add('                r["text"], r["json"] = poll_until_done(aw, r["json"], inputs, results, sugar)');
L.Add('                if aw.get("output_selector"):');
L.Add('                    v = eval_selector(r["json"], aw["output_selector"])');
L.Add('                    if v is not None:');
L.Add('                        r["text"] = v');
L.Add('        except StepError as e:');
L.Add('            r["ok"], r["error"] = False, str(e)');
L.Add('        print("  %s %s (%s)" % ("ok  " if r["ok"] else "FAIL", nid, node["tool"]), file=sys.stderr)');
L.Add('        results.append(r)');
L.Add('        if not r["ok"]:');
L.Add('            return False, results, ''node "%s" (%s) failed: %s'' % (nid, node["tool"], r["error"])');
L.Add('    return True, results, ""');
L.Add('');
L.Add('');
L.Add('def resolve_outputs(spec, inputs, results):');
L.Add('    out, errs = {}, []');
L.Add('    for o in spec["outputs"]:');
L.Add('        if not pas_trim(o["name"]):');
L.Add('            continue');
L.Add('        try:');
L.Add('            out[o["name"]] = resolve_one(o["value"], inputs, results)');
L.Add('        except StepError as e:');
L.Add('            out[o["name"]] = ""');
L.Add('            errs.append("%s: %s" % (o["name"], e))');
L.Add('    return out, errs');
L.Add('');
L.Add('');
L.Add('def run_repeated(spec, inputs):');
L.Add('    loop = spec.get("loop")');
L.Add('    if not loop:');
L.Add('        return run_workflow(spec, inputs)');
L.Add('    max_it = min(max(int(loop.get("max", 1)), 1), 100)');
L.Add('    cur = dict(inputs)');
L.Add('    for it in range(1, max_it + 1):');
L.Add('        ok, results, err = run_workflow(spec, cur)');
L.Add('        if not ok:');
L.Add('            return ok, results, err');
L.Add('        out, _ = resolve_outputs(spec, cur, results)');
L.Add('        until = loop.get("until", "")');
L.Add('        if until:');
L.Add('            try:');
L.Add('                v = resolve_one(until, cur, results)');
L.Add('            except StepError:');
L.Add('                v = ""');
L.Add('            if pas_trim(v).lower() in ("true", "yes", "done", "1", "stop", "complete"):');
L.Add('                return ok, results, err');
L.Add('        if it == max_it:');
L.Add('            return ok, results, err');
L.Add('        for fb in loop.get("feedback", []):');
L.Add('            if fb.get("input") and fb.get("output") in out:');
L.Add('                cur[fb["input"]] = out[fb["output"]]');
L.Add('    return False, [], "loop did not run"');
L.Add('');
L.Add('');
L.Add('def write_outputs(spec, outputs, base):');
L.Add('    stamp = time.strftime("%Y%m%dT%H%M%S")');
L.Add('    os.makedirs(base, exist_ok=True)');
L.Add('    run_dir, n = os.path.join(base, stamp), 1');
L.Add('    while True:');
L.Add('        try:');
L.Add('            os.mkdir(run_dir)');
L.Add('            break');
L.Add('        except FileExistsError:');
L.Add('            n += 1');
L.Add('            run_dir = os.path.join(base, "%s-%d" % (stamp, n))');
L.Add('    with open(os.path.join(run_dir, "output.json"), "w", encoding="utf-8") as f:');
L.Add('        f.write(json.dumps(outputs, ensure_ascii=False) + "\n")');
L.Add('    for name, val in outputs.items():');
L.Add('        if not isinstance(val, str) or val == "":');
L.Add('            continue');
L.Add('        ext = ".md" if val.startswith("# ") or "\n#" in val else ".txt"');
L.Add('        safe = "".join(c if c.isascii() and (c.isalnum() or c in "-_") else "_" for c in name) or "output"');
L.Add('        with open(os.path.join(run_dir, safe + ext), "w", encoding="utf-8") as f:');
L.Add('            f.write(val + "\n")');
L.Add('    return run_dir');
L.Add('');
L.Add('');
L.Add('def main(argv=None):');
L.Add('    spec = WORKFLOW');
L.Add('    lines = ["inputs:"] + ["  %s: %s%s" % (i["name"], i["type"], " (required)" if i["required"] else "")');
L.Add('                           for i in spec["inputs"]] if spec["inputs"] else ["(no inputs)"]');
L.Add('    ap = argparse.ArgumentParser(');
L.Add('        description="%s -- %s" % (spec["name"], spec["description"] or "a PasClaw workflow"),');
L.Add('        epilog="\n".join(lines), formatter_class=argparse.RawDescriptionHelpFormatter)');
L.Add('    ap.add_argument("--input", action="append", default=[], metavar="NAME=VALUE",');
L.Add('                    help="a workflow input (repeatable)")');
L.Add('    ap.add_argument("--json", action="store_true", help="print the outputs as JSON")');
L.Add('    ap.add_argument("--out-dir", default=None,');
L.Add('                    help="where a run''s declared outputs are written (default: %s)"');
L.Add('                         % (spec["output_dir"] or "workflows/" + spec["id"]))');
L.Add('    ap.add_argument("--no-files", action="store_true", help="do not write the outputs to files")');
L.Add('    a = ap.parse_args(argv)');
L.Add('    inputs = {}');
L.Add('    for kv in a.input:');
L.Add('        if "=" not in kv:');
L.Add('            ap.error("--input wants NAME=VALUE, got %r" % kv)');
L.Add('        k, v = kv.split("=", 1)');
L.Add('        inputs[k] = v');
L.Add('    missing = [i["name"] for i in spec["inputs"] if i["required"] and i["name"] not in inputs]');
L.Add('    if missing:');
L.Add('        ap.error("missing required input(s): " + ", ".join(missing))');
L.Add('    try:');
L.Add('        ok, results, err = run_repeated(spec, inputs)');
L.Add('    finally:');
L.Add('        if _POOL:');
L.Add('            _POOL[0].close()');
L.Add('    if not ok:');
L.Add('        print("error: " + err, file=sys.stderr)');
L.Add('        return 1');
L.Add('    if spec["outputs"]:');
L.Add('        output, errs = resolve_outputs(spec, inputs, results)');
L.Add('        for e in errs:');
L.Add('            print("output error: " + e, file=sys.stderr)');
L.Add('        if not a.no_files:');
L.Add('            d = write_outputs(spec, output, a.out_dir or spec["output_dir"] or "workflows/" + spec["id"])');
L.Add('            print("outputs written to " + d, file=sys.stderr)');
L.Add('    else:');
L.Add('        last = next((r["text"] for r in reversed(results) if r["text"]), "")');
L.Add('        output = {"output": last}');
L.Add('    if a.json:');
L.Add('        print(json.dumps(output, ensure_ascii=False))');
L.Add('    elif len(output) == 1:');
L.Add('        print(next(iter(output.values())))');
L.Add('    else:');
L.Add('        for k, v in output.items():');
L.Add('            print("%s: %s" % (k, v))');
L.Add('    return 0');
L.Add('');
L.Add('');
L.Add('if __name__ == "__main__":');
L.Add('    sys.exit(main())');
